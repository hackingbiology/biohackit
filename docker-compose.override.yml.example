# Copy to docker-compose.override.yml and customise.
# This file is .gitignored — it is never committed.
#
# Example: change the host ports to avoid clashes with other local projects.

services:
  db:
    ports:
      - "5433:5432"

  backend:
    ports:
      - "8001:8000"

  frontend:
    ports:
      - "3001:3000"
