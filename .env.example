# biohack.it — environment variables
# Copy to .env and fill in real values.  Never commit .env.

# ---- Django core -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-use-get-random-secret-key

# Set to false in production
DEBUG=true

# Comma-separated list of hostnames Django will serve
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database --------------------------------------------------------------
# TimescaleDB / PostgreSQL DSN
DATABASE_URL=postgres://biohackit:biohackit@localhost:5432/biohackit

# ---- CORS ------------------------------------------------------------------
# Comma-separated origins allowed by django-cors-headers (add in TG2)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- JWT -------------------------------------------------------------------
# These are read from SIMPLE_JWT in settings.py;
# documented here for ops reference.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Throttling ------------------------------------------------------------
# Number of reverse proxies in front of Django. 0 (default) = none: the client is REMOTE_ADDR and
# X-Forwarded-For is ignored. Set it only to the real proxy count, or the header can be spoofed
# to dodge the anonymous throttle on /api/public/protocols/.
# DRF_NUM_PROXIES=0

# ---- Frontend (Next.js) ----------------------------------------------------
# Base URL the browser uses to reach the Django API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Social login (m00b): a provider is enabled only if its variables are set
FRONTEND_URL=http://localhost:3000
# rapamycin.news via DiscourseConnect (admin enables "DiscourseConnect provider")
RAPAMYCIN_NEWS_URL=
RAPAMYCIN_NEWS_SSO_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_SECRET=
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
WEIXIN_CLIENT_ID=
WEIXIN_SECRET=
